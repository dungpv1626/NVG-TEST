# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
# `web/` khai báo outDir riêng là dist-types/ (chỉ chứa .d.ts do tsc sinh ra),
# nên mẫu dist/ ở trên không bắt được — kết quả là mỗi commit lẫn ~78 file sinh tự động.
dist-types/
build/
.wrangler/
.open-next/
*.tsbuildinfo

# Môi trường — KHÔNG BAO GIỜ commit secret (TSD 5.6)
.env
.env.local
.env.*.local
.dev.vars
# Cấu hình của bản CHẠY THỬ / DEMO (project cloud) — có khoá service_role và mật khẩu CSDL.
.env.demo
.dev.vars.demo

# Logs & cache
*.log
npm-debug.log*
.npm/
.cache/
.vite/

# Test output
coverage/
playwright-report/
test-results/

# Editor / OS
.DS_Store
.idea/
*.swp

# Tài liệu trích xuất tạm (bản gốc .docx vẫn được commit)
doc/*.md

# File lock tạm của LibreOffice/Word
.~lock.*#
~$*

# Module Thiết kế: tài nguyên nặng / không được phát tán lại
# - kb/vendor/: bộ cài ODA File Converter (~100MB, giấy phép Open Design Alliance
#   không cho phát tán lại). Dockerfile COPY vào image lúc build.
# - kb/samples/: hồ sơ .dwg thật của NVG — dữ liệu khách hàng, không lên git.
# Loại trừ NỘI DUNG chứ không loại trừ thư mục: git không đi vào thư mục đã bị
# loại, nên dòng phủ định `!` sẽ vô tác dụng nếu viết `kb/vendor/`.
kb/vendor/*
!kb/vendor/README.md
kb/samples/*
!kb/samples/README.md

# Ảnh đối chiếu do pipeline trích xuất sinh ra
kb/out/

# Python bytecode do container/pytest sinh ra khi chạy với thư mục nguồn được gắn vào.
__pycache__/
*.py[cod]
.pytest_cache/
