{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvg.vn/contracts/ai-house-bands-delta.schema.json",
  "title": "AiHouseBandsDelta",
  "$comment": "Vòng sửa đường v6 (T116): chỉ trả các TẦNG cần đổi, mỗi tầng trọn danh sách dải mới; tầng không nhắc giữ nguyên. Tầng đã qua bị khoá — chương trình bỏ phần chạm vào.",
  "type": "object",
  "additionalProperties": false,
  "required": ["storeys", "doors_prefer", "cantilevers_upsert", "notes"],
  "properties": {
    "storeys": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "bands"],
        "properties": {
          "level": {
            "type": "string",
            "pattern": "^([1-9][0-9]?|roof)$"
          },
          "bands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["depth", "cells"],
              "properties": {
                "depth": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Chiều sâu mm; 0 = chương trình tính."
                },
                "cells": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "w", "stack"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9_.]+$|^THANG$|^LW$|^$",
                        "maxLength": 32,
                        "description": "Mã phòng của danh mục (`knowledge.program`) hay mã tự thêm có tiền tố `knowledge.model_added`; `THANG` = ô thang; `.` = sân / phần không xây (chỉ ở mép khối). Rỗng \"\" khi ô là một chồng (`stack`)."
                      },
                      "w": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Bề rộng mm theo mặt tiền. 0 = chương trình tính; > 0 chỉ khi cần cố định (hành lang, ô thang)."
                      },
                      "stack": {
                        "type": "array",
                        "maxItems": 6,
                        "description": "Ô chia tiếp theo chiều sâu, từ phía đường vào; rỗng = ô một phòng.",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["id", "d"],
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[a-z0-9_.]+$|^THANG$|^LW$|^$",
                              "maxLength": 32
                            },
                            "d": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "Chiều sâu mm; 0 = chương trình tính. Ô con cuối nhận phần dư."
                            }
                          }
                        }
                      }
                    }
                  },
                  "description": "Ô từ trái sang phải nhìn từ đường."
                }
              }
            },
            "description": "Dải từ mặt đường vào sâu."
          }
        }
      }
    },
    "doors_prefer": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "maxLength": 32
        }
      },
      "description": "Cặp phòng nên có cửa khi có nhiều chỗ mở — chương trình đặt cửa."
    },
    "cantilevers_upsert": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from_room", "face", "depth"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 32
          },
          "from_room": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 32
          },
          "face": {
            "type": "string",
            "enum": ["front", "left", "back", "right"]
          },
          "depth": {
            "type": "integer"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
