{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvg.vn/contracts/infeasibility-report.schema.json",
  "title": "InfeasibilityReport",
  "description": "Báo cáo vô nghiệm — quan trọng ngang FloorPlan, là thứ tạo ra tính năng phân tích tác động. Nguồn: doc/design/03-data-contracts.md mục 3.5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "conflict_set", "human_message"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "status": { "type": "string", "const": "infeasible" },
    "rule_pack_version": { "type": "string" },
    "conflict_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id"],
        "properties": {
          "rule_id": { "type": "string" },
          "involved": { "type": "array", "items": { "type": "string" } }
        }
      },
      "description": "Lấy từ cơ chế giả định (assumptions) của CP-SAT. ⚠️ OR-Tools chỉ hứa tập ĐỦ, không hứa tập nhỏ nhất — bộ giải phải thu hẹp thêm bằng bộ lọc xoá dần (vướng mắc V-4 trong TIEN_DO_THIET_KE.html)."
    },
    "human_message": {
      "type": "string",
      "minLength": 1,
      "description": "Sinh từ MẪU CÂU theo rule_id, KHÔNG gọi mô hình ngôn ngữ: tất định, rẻ, dịch được, không bịa (07-rule-pack 7.6)."
    },
    "suggested_relaxations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": { "type": ["string", "null"] },
          "target": {
            "type": ["string", "null"],
            "description": "Đường dẫn tới trường đầu vào, ví dụ site.width_m."
          },
          "action": {
            "type": ["string", "null"],
            "enum": ["shrink_adjacent", "move_to_floor", "remove", "none", null]
          },
          "from": { "type": ["number", "null"] },
          "to": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"], "enum": ["m", "m2", "count", null] }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  }
}
