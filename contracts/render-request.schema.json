{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvg.vn/contracts/render-request.schema.json",
  "title": "RenderRequest",
  "description": "Yêu cầu sinh ảnh — Layer 5, đi qua interface RenderBackend. Nguồn: doc/design/03-data-contracts.md mục 3.7.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "arch_ref", "views", "data_class"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "arch_ref": { "$ref": "#/$defs/artifact_ref" },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "camera"],
        "properties": {
          "id": { "type": "string" },
          "camera": {
            "type": "string",
            "enum": ["street_level", "aerial", "interior", "eye_level"]
          },
          "clay_png": { "$ref": "#/$defs/store_uri" },
          "depth_png": { "$ref": "#/$defs/store_uri" },
          "edge_png": { "$ref": "#/$defs/store_uri" }
        }
      }
    },
    "style_preset": { "type": ["string", "null"] },
    "workflow": {
      "type": ["string", "null"],
      "description": "Đường dẫn tệp workflow ComfyUI — định dạng đã chốt, nơi chạy chưa chốt (05-tech-stack 5.7)."
    },
    "variants_per_view": { "type": "integer", "minimum": 1, "maximum": 8 },
    "data_class": { "$ref": "#/$defs/data_class" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "artifact_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "store_uri": {
      "type": ["string", "null"],
      "pattern": "^(r2|supabase)://.+",
      "description": "URI có scheme để đổi kho lưu trữ mà không sửa nơi gọi (interface ArtifactStore — CLAUDE.md 8.5 T4)."
    },
    "data_class": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "1 nhạy cảm (thông tin khách, đầu bài) · 2 trung bình (mặt bằng kích thước thật) · 3 thấp (clay render, depth map). Lớp chặn so với max_data_class trong config/models.yaml (01-overview 1.5)."
    }
  }
}
