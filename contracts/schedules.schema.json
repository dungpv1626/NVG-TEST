{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvg.vn/contracts/schedules.schema.json",
  "title": "Schedules",
  "description": "Bảng thống kê cửa · cửa sổ · diện tích · vật liệu — sinh tự động từ FloorPlan. Nguồn: doc/design/03-data-contracts.md mục 3.6. ⚠️ Mọi bảng khối lượng xuất ra mang nhãn 'Khối lượng sơ bộ — không dùng làm căn cứ ký hợp đồng' do MÃ NGUỒN chèn (CLAUDE.md 8.7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "floorplan_ref"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "floorplan_ref": { "$ref": "#/$defs/artifact_ref" },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "w_m", "h_m", "count"],
        "properties": {
          "code": { "type": "string" },
          "w_m": { "type": "number", "exclusiveMinimum": 0 },
          "h_m": { "type": "number", "exclusiveMinimum": 0 },
          "count": { "type": "integer", "minimum": 0 },
          "material": { "type": ["string", "null"] }
        }
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "w_m", "h_m", "count"],
        "properties": {
          "code": { "type": "string" },
          "w_m": { "type": "number", "exclusiveMinimum": 0 },
          "h_m": { "type": "number", "exclusiveMinimum": 0 },
          "count": { "type": "integer", "minimum": 0 },
          "material": { "type": ["string", "null"] }
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "room_type", "area_m2"],
        "properties": {
          "level": { "type": "integer", "minimum": 1 },
          "room_type": { "type": "string" },
          "area_m2": { "type": "number", "minimum": 0 }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "area_m2": { "type": ["number", "null"], "minimum": 0 },
          "volume_m3": { "type": ["number", "null"], "minimum": 0 },
          "count": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "disclaimer": {
      "type": "string",
      "const": "Khối lượng sơ bộ — không dùng làm căn cứ ký hợp đồng",
      "description": "Nhãn cảnh báo bắt buộc, do mã nguồn chèn, không tắt được từ giao diện (01-overview 1.4)."
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "artifact_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
