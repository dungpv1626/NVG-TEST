{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvg.vn/contracts/ai-brief-digest.schema.json",
  "title": "AiBriefDigest",
  "description": "Bản đầu bài + khảo sát GỬI CHO mô hình của nhà cung cấp ngoài (nhánh AI, T12). Đây là DANH SÁCH CHO PHÉP: additionalProperties=false ở mọi cấp, nên một trường mới thêm vào design-brief không tự đi ra mạng. Cố ý KHÔNG có: project_id, project_code, budget_range_vnd, decision_maker, legal_docs, completeness_score. Chữ tự do đi qua sau khi lược danh tính (scrubIdentity). Hạng dữ liệu 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "building_type",
    "locality",
    "floors",
    "site",
    "family",
    "required_spaces",
    "priorities",
    "free_text",
    "survey"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "building_type": { "type": "string", "enum": ["nha_pho", "biet_thu", "nha_vuon"] },
    "locality": { "type": "string" },
    "floors": { "type": "integer", "minimum": 1 },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_m", "depth_m"],
      "properties": {
        "shape": {
          "type": ["string", "null"],
          "enum": ["chu_nhat", "hinh_thang", "da_giac", null]
        },
        "width_m": { "type": "number" },
        "depth_m": { "type": "number" },
        "rear_width_m": { "type": ["number", "null"] },
        "boundary_m": {
          "type": ["array", "null"],
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        },
        "orientation": {
          "type": ["string", "null"],
          "enum": ["B", "BD", "D", "DN", "N", "TN", "T", "TB", null]
        },
        "access_sides": {
          "type": "array",
          "items": { "type": "string", "enum": ["front", "back", "left", "right"] }
        },
        "adjacent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "front": { "type": ["string", "null"] },
            "back": { "type": ["string", "null"] },
            "left": { "type": ["string", "null"] },
            "right": { "type": ["string", "null"] }
          }
        },
        "setback_required_m": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "front": { "type": "number" },
            "back": { "type": "number" },
            "left": { "type": "number" },
            "right": { "type": "number" }
          }
        },
        "max_density": { "type": ["number", "null"] }
      }
    },
    "family": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "count"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["ong_ba", "vo_chong", "con", "khach", "nguoi_giup_viec"]
          },
          "count": { "type": "integer", "minimum": 0 },
          "floor": { "type": ["integer", "null"] },
          "floor_pref": { "type": ["string", "null"], "enum": ["low", "mid", "top", null] },
          "needs": { "type": "array", "items": { "type": "string" } },
          "ensuite": { "type": ["boolean", "null"] }
        }
      }
    },
    "required_spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "floor": { "type": ["integer", "null"] },
          "area_m2": { "type": ["number", "null"] },
          "ensuite": { "type": ["boolean", "null"] },
          "amenities": { "type": ["string", "null"] }
        }
      }
    },
    "massing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "wings_preferred": { "type": ["integer", "null"] },
        "footprint_shape": {
          "type": ["string", "null"],
          "enum": ["chu_nhat", "L", "U", "T", null]
        },
        "cores_preferred": { "type": ["integer", "null"] },
        "service_core": { "type": ["boolean", "null"] },
        "yards": {
          "type": "array",
          "items": { "type": "string", "enum": ["san_truoc", "san_ben", "san_trong", "san_sau"] }
        },
        "indoor_outdoor": {
          "type": ["string", "null"],
          "enum": ["mo_toi_da", "can_bang", "kin_dao", null]
        }
      }
    },
    "style": {
      "type": ["string", "null"],
      "enum": [
        "hien_dai",
        "tan_co_dien",
        "indochine",
        "mai_thai",
        "toi_gian",
        "nhiet_doi",
        "dia_trung_hai",
        "co_dien",
        "bac_au",
        null
      ]
    },
    "priorities": { "type": "array", "items": { "type": "string" } },
    "free_text": {
      "description": "Năm ô chữ tự do của đầu bài, ĐÃ lược danh tính. legal_documents cố ý không có: hay chứa số sổ đỏ.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design_task": { "type": ["string", "null"] },
        "functional_needs": { "type": ["string", "null"] },
        "style_note": { "type": ["string", "null"] },
        "site_condition": { "type": ["string", "null"] }
      }
    },
    "survey": {
      "description": "Biên bản khảo sát hiện trạng gắn với đầu bài (site_source_survey_id), đã lược danh tính. null khi đầu bài nhập tay.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "land_width_m": { "type": ["number", "null"] },
        "land_depth_m": { "type": ["number", "null"] },
        "land_area_m2": { "type": ["number", "null"] },
        "orientation": { "type": ["string", "null"] },
        "measurement_notes": { "type": ["string", "null"] },
        "surrounding_notes": { "type": ["string", "null"] },
        "usage_notes": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  }
}
