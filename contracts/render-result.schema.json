{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvg.vn/contracts/render-result.schema.json",
  "title": "RenderResult",
  "description": "Kết quả sinh ảnh — Layer 5. Nguồn: doc/design/03-data-contracts.md mục 3.7.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "images", "backend"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["view", "variant", "uri", "watermark_applied"],
        "properties": {
          "view": { "type": "string" },
          "variant": { "type": "integer", "minimum": 1 },
          "uri": { "type": "string", "pattern": "^(r2|supabase)://.+" },
          "watermark_applied": {
            "type": "boolean",
            "description": "Phải là true TRƯỚC khi ảnh hiển thị cho khách. Kiểm tra trong mã nguồn, không tin tưởng (03-data-contracts 3.7). Nhãn: 'Ảnh tham khảo ý tưởng — chưa phải phương án thi công'."
          }
        }
      }
    },
    "backend": {
      "type": "string",
      "enum": ["local_workstation", "serverless", "api_service", "stub"]
    },
    "duration_s": { "type": ["number", "null"], "minimum": 0 }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  }
}
