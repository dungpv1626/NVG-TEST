 "intents": {
  "round1": {
   "variant_label": "Nhà phố giếng trời – thang giữa",
   "rationale": "Tầng một ưu tiên gara xuyên mặt tiền, vào thẳng phòng khách phía sau để phù hợp lô đất ngang 5 m. Thang chữ U, giếng trời và các khu vệ sinh được gom vào lõi giữa–sau nhà để lấy sáng, thông gió cho các tầng. Tầng trên phân khu yên tĩnh, phòng thờ tách khỏi WC và sân thượng được chuyển ra mặt trước theo giới hạn mặt thoáng khả dụng.",
   "assumptions": [
    "Yêu cầu sân thượng phía sau không thể đồng thời đáp ứng quy tắc mặt dài sân thượng phải nằm ở mặt mở; phương án đặt sân thượng nhỏ tại mặt trước.",
    "Khoảng lùi sau 1,5 m cần được xác nhận có áp dụng cho toàn bộ các tầng hay chỉ khối tầng một, vì tổng các không gian bắt buộc và gara tối thiểu rất chặt trong lưới 5 m x 16,5 m.",
    "Khu giặt phơi dùng ô thoáng kỹ thuật và kết nối thuận tiện với sân thượng tầng trên để phơi nắng ngoài trời."
   ],
