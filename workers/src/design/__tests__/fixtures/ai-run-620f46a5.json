 "intents": {
  "round1": {
   "variant_label": "Nhà vườn một tầng thoáng gió",
   "rationale": "Khối nhà bố trí theo trục trước–sau, phòng khách nhận gió và ánh sáng mặt trước/phải, các phòng ngủ tập trung về phía sau yên tĩnh. Bếp–ăn liên thông để sử dụng diện tích hiệu quả; khu giặt phơi mở ra sân sau để lấy nắng. Phòng thờ tách khỏi khu vệ sinh và đặt sâu trong nhà.",
   "assumptions": [
    "Gia chủ xác nhận lõi thang chỉ là vị trí chờ kỹ thuật lên mái để bảo trì bồn nước, bình nước nóng và cục nóng điều hòa.",
    "Khu làm việc tại nhà được bố trí bằng bàn làm việc trong phòng ngủ chính hoặc phòng khách, không tách thành phòng làm việc riêng.",
    "Kho chung nhỏ bố trí bằng hệ tủ/kho âm trong khu bếp và hành lang; không lập phòng kho riêng để bảo đảm diện tích sử dụng."
   ],
