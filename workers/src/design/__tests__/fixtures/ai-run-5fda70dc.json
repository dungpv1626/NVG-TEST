 },
 "intents": {
  "round1": {
   "variant_label": "Lõi thang phải, LDK mở, sân vườn trái",
   "rationale": "Đặt thang và cụm ướt dọc ranh phải để xếp chồng kỹ thuật, mở khối sinh hoạt (khách–ăn–bếp) ra mặt trước và sân bên trái để lấy sáng và gắn kết sân vườn. Phòng ngủ ông bà yên tĩnh phía sau có WC khép kín; tầng 2 tách biệt các thế hệ, mỗi phòng con có ban công riêng, phòng thờ nhìn hướng Đông Nam. Hai dải giao thông ở tầng 2 đảm bảo tiếp cận ngắn gọn tới mọi phòng.",
   "assumptions": [
    "Có cần cửa kết nối trong nhà từ gara vào khối thang/không gian chung không?",
    "Bàn thờ cần quay mặt chính xác về Đông Nam hay chỉ cần đặt ở không gian phía trước để đón hướng này?",
    "Phòng giúp việc ưu tiên gần bếp hay tách xa khu bếp để yên tĩnh?",
    "Khu giặt phơi mong muốn phơi ngoài trời (sân phơi) hay che kín, có nhu cầu đặt máy sấy không?",
    "Có yêu cầu thêm WC rửa tay gần phòng khách (ngoài các WC đã bố trí) không?"
   ],
