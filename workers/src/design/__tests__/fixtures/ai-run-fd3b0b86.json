    "free_text": {
      "design_task": "Thiết kế biệt thự nhà vườn hai tầng trên lô 15 × 20 m, ba thế hệ cùng ở, ưu tiên sân vườn và lấy sáng tự nhiên.",
      "functional_needs": "Tầng 1: để xe, khách, ăn, bếp, phòng ngủ ông bà, phòng ngủ giúp việc, khu phụ trợ. Tầng 2: phòng ngủ chính, phòng ngủ con, phòng ngủ khách phòng làm việc, phòng thờ, ban công.",
      "style_note": "Hiện đại, mái dốc nhẹ, vật liệu hoàn thiện đơn giản, dễ bảo trì.",
      "site_condition": "Giáp đường lớn phía trước, hẻm 3 m bên trái, nhà hàng xóm bên phải, đất trống phía sau."
    },
    "survey": null
  },
  "intents": {
    "round1": {
      "variant_label": "Nhà vườn 2 tầng – lõi thang giữa, sân trước – sân bên",
      "rationale": "Đặt thang và khối ướt giữa nhà về phía phải để tối ưu thông gió, còn khối sinh hoạt mở hướng ra sân trước – sân bên (đông nam và phía trái). Tầng 1 ưu tiên khách – bếp ăn mở gắn sân vườn, ngủ ông bà khép kín tĩnh ở cuối nhà; tầng 2 tách biệt khối ngủ bố mẹ – con, có hành lang sáng và ban công riêng. Các khu ướt tầng 2 xếp trên khu ướt tầng 1, có giếng trời sau thang.",
      "assumptions": [
        "Khối 13×17 m đã trừ khoảng lùi pháp lý; nếu cần giữ sân trước 3 m và sân bên 2 m đúng mong muốn, cho phép giảm diện tích xây để vẫn đáp ứng công năng?",
        "Gara để 1 ô tô + 2 xe máy (và 1 xe máy điện) chấp nhận dạng thẳng 3×7 m có ổ cắm sạc ở tường phải?",
        "Bàn thờ đặt phía trước tầng 2 quay đúng hướng đông nam, chấp nhận cửa một lớp ngăn riêng tư với hành lang?",
        "Bếp dùng bếp từ, cần chỗ máy rửa bát và tủ lạnh side-by-side bố trí liền khối?",
        "Ưu tiên yên tĩnh: có đồng ý dùng kính hộp/lam che nắng mặt trước để tăng riêng tư cho phòng khách rộng?"
      ],
