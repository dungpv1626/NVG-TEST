  "intents": {
    "round1": {
      "variant_label": "Phương án 1 — Hiện đại, lõi giữa, sân trước + sân bên",
      "rationale": "Phân khu công năng theo trục trước–sau: khách + ăn bếp phía trước, khối ngủ và phụ trợ lùi sâu; thang đặt gần biên trái để gom ướt và tối ưu thông gió từ hẻm trái. Tầng 1 ưu tiên ông bà (khép kín) và giúp việc; tầng 2 tách biệt vợ chồng, 2 con và phòng khách; các ban công và thờ hướng Đông Nam. Diện tích mục tiêu mỗi tầng ≈ 80–85% diện tích sàn, bám sát dải chuẩn và tối thiểu chủ nhà nêu.",
      "assumptions": [
        "Có thể chấp nhận sân trước lùi 3 m và sân bên trái lùi 2 m như mong muốn (vượt khoảng lùi bắt buộc 2 m) để tăng cây xanh?",
        "Ô tô là sedan cỡ trung (gar. 20–24 m²) hay cần rộng hơn cho SUV (điều chỉnh 24–28 m²)?",
        "Bếp mong muốn dạng mở hoàn toàn với phòng ăn/phòng khách hay cần vách kính/đảo bếp lớn (ảnh hưởng diện tích bếp và kho)?",
        "Phòng làm việc tầng 2 ưu tiên yên tĩnh gần phòng ngủ chính hay gần khu con để giám sát học tập?",
        "Ban công cho 2 phòng con cần tách riêng từng phòng hay chấp nhận loggia chung dài?"
      ],
