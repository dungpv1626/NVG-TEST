  "intents": {
    "round1": {
      "variant_label": "Một lõi – sân trước trái",
      "rationale": "Đặt thang làm lõi lệch trái, không gian khách – ăn – bếp mở dọc trục trước–sau để lấy sáng tự nhiên từ mặt trước và hẻm trái. Khối ngủ ông bà và gara gom về phải để yên tĩnh và tiện đi lại, tầng 2 tổ chức các phòng ngủ quanh lõi giao thông, có ban công riêng. Bố cục chữ nhật, sân trước và khoảng mở bên trái tăng mảng xanh và thông gió chéo.",
      "assumptions": [
        "Có thể chấp nhận hi sinh khoảng sân trước 3 m thành 2 m (đúng quy định) để nới diện tích trong nhà?",
        "Gia chủ đồng ý có phòng sinh hoạt chung nhỏ (living) ở tầng 2 làm sảnh chung kết nối các phòng?",
        "Ban công phòng con chấp nhận quay ra mặt trái/ trước tùy vị trí?",
        "Khu thờ cần tách riêng kín, không mở với sinh hoạt chung?",
        "Ưu tiên bếp – ăn liên thông hoàn toàn với khách hay tách bớt bằng tủ thấp?"
      ],
