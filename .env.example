# ============================================================================
# NVG — Biến môi trường
# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# Tech Stack Mục 5.6: khóa bí mật lưu trong Cloudflare Workers Secrets, không vào mã nguồn.
# ============================================================================

# --- Supabase PHÁT TRIỂN = chạy TẠI MÁY -------------------------------------
# Từ 30/09/2026 (C-1) máy phát triển KHÔNG dùng project cloud. Bật CSDL máy:
#     npm run db:start          # Docker; lần đầu tải ảnh khá lâu
#     npx supabase status -o env   # in ra đúng bốn giá trị cần điền dưới đây
#     npm run db:migrate && npm run db:seed
# Cổng 553xx (xem supabase/config.toml), không phải 543xx mặc định.
SUPABASE_URL=http://127.0.0.1:55321

# Khóa công khai (anon). An toàn để lộ ra Frontend vì bị RLS giới hạn hoàn toàn.
SUPABASE_ANON_KEY=

# Khóa service_role — VƯỢT QUA RLS. CHỈ dùng trong Workers cho tác vụ hệ thống.
SUPABASE_SERVICE_ROLE_KEY=

# Chuỗi kết nối Postgres — dùng cho migration Drizzle, seed và bộ test `db/`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Bản chạy thử / demo trên cloud: cấu hình nằm ở `.env.demo` (cùng tên biến, KHÔNG commit), chỉ
# dùng qua `npm run db:migrate:demo` lúc phát hành. Ở cloud, dùng «Session pooler» (cổng 5432):
# kết nối trực tiếp db.<ref>.supabase.co chỉ có IPv6, còn Transaction pooler (6543) không chạy được
# một số lệnh DDL của migration. Tên đăng nhập ở pooler là `postgres.<project-ref>`.

# --- Cloudflare -------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
# Token cần quyền Workers Scripts:Edit + Pages:Edit.
# Hoặc bỏ trống và chạy `npx wrangler login` để xác thực qua trình duyệt.
CLOUDFLARE_API_TOKEN=

# --- Email giao dịch (Tech Stack 3.3) --------------------------------------
# Dùng cho email mời tài khoản / đặt lại mật khẩu. Có thể để trống giai đoạn đầu
# và dùng SMTP mặc định của Supabase.
RESEND_API_KEY=

# --- AI (Tech Stack 3.5) ----------------------------------------------------
# Gemini — dùng cho DA-11 và Phase 5 (AI Design Engine). Chưa cần ở Phase 0-2.
# CẢNH BÁO: gói miễn phí có thể được Google dùng để cải thiện sản phẩm.
# Không gửi dữ liệu nội bộ nhạy cảm nhiều hơn mức cần thiết (PRD 2.4, Tech Stack 3.5).
GEMINI_API_KEY=

# Pollinations — dịch vụ dựng ảnh phối cảnh của Module Thiết kế (tuyến `layer5_render`, TK-16).
# CHỈ dùng phía Worker. KHÔNG BAO GIỜ đặt tiền tố VITE_ cho khoá này.
# Mô hình và địa chỉ endpoint KHÔNG nằm ở đây mà ở `config/models.yaml` (tệp có phiên bản, có
# chú thích) — đổi mô hình là sửa một dòng ở đó, không sửa mã và không đổi biến môi trường.
POLLINATIONS_API_KEY=

# OpenAI và Anthropic — nhánh thiết kế bằng AI (T10–T13). API trả phí, cam kết không huấn
# luyện trên dữ liệu gửi qua API; tuyến `ai_*` trong `config/models.yaml` nhận đầu bài đã lược
# danh tính (hạng 2). CHỈ dùng phía Worker, KHÔNG BAO GIỜ đặt tiền tố VITE_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini GÓI TRẢ PHÍ cho nhánh AI (nhà cung cấp `gemini_paid`). Tách khỏi GEMINI_API_KEY ở trên
# (gói miễn phí, chỉ dữ liệu ẩn danh): cùng API, khác cam kết dữ liệu, nên không dùng chung biến.
GEMINI_PAID_API_KEY=

# --- Frontend (Vite) --------------------------------------------------------
# Vite chỉ đưa ra trình duyệt các biến có tiền tố VITE_. Chỉ đặt ở đây khóa CÔNG KHAI.
# Khóa service_role KHÔNG BAO GIỜ được có tiền tố VITE_.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=

# Địa chỉ Worker API của Module Thiết kế AI (tiền tố `/design`).
# Chỉ MỘT thao tác của giao diện cần tới nó: chú giải hồ sơ cũ, vì bước đó phải tính vector
# nhúng bằng khoá mà trình duyệt không được cầm. Mọi thứ còn lại gọi thẳng Supabase.
# Chạy ở máy: http://localhost:8788 (npx wrangler dev --config workers/wrangler.jsonc).
# Để trống thì màn hình chú giải báo "chưa cấu hình" bằng tiếng Việt, không trắng màn hình.
VITE_DESIGN_API_URL=
