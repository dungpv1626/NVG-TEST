# ============================================================================
# NVG — Biến môi trường
# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# Tech Stack Mục 5.6: khóa bí mật lưu trong Cloudflare Workers Secrets, không vào mã nguồn.
# ============================================================================

# --- Supabase (dự án DEV) ---------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co

# Khóa công khai (publishable/anon). An toàn để lộ ra Frontend vì bị RLS giới hạn hoàn toàn.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Khóa service_role — VƯỢT QUA RLS.
# CHỈ dùng trong Cloudflare Workers cho tác vụ hệ thống. KHÔNG BAO GIỜ đưa vào Frontend.
# Lấy tại: Supabase Dashboard > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Chuỗi kết nối Postgres — dùng cho migration Drizzle và seed.
# Lấy tại: Supabase Dashboard > Project Settings > Database > Connection string
# Lưu ý: dùng cổng 5432 (direct) cho migration, KHÔNG dùng 6543 (pooler) vì pooler
# không hỗ trợ một số lệnh DDL.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Cloudflare -------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
# Token cần quyền Workers Scripts:Edit + Pages:Edit.
# Hoặc bỏ trống và chạy `npx wrangler login` để xác thực qua trình duyệt.
CLOUDFLARE_API_TOKEN=

# --- Email giao dịch (Tech Stack 3.3) --------------------------------------
# Dùng cho email mời tài khoản / đặt lại mật khẩu. Có thể để trống giai đoạn đầu
# và dùng SMTP mặc định của Supabase.
RESEND_API_KEY=

# --- AI (Tech Stack 3.5) ----------------------------------------------------
# Gemini — dùng cho DA-11 và Phase 5 (AI Design Engine). Chưa cần ở Phase 0-2.
# CẢNH BÁO: gói miễn phí có thể được Google dùng để cải thiện sản phẩm.
# Không gửi dữ liệu nội bộ nhạy cảm nhiều hơn mức cần thiết (PRD 2.4, Tech Stack 3.5).
GEMINI_API_KEY=
